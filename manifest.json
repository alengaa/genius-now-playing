{
	"manifest_version": 2,
	"name": "Genius Now Playing",
	"version": "2.0.0",
	"background": {
		"scripts": ["src/background/background.js"]
	},
	"content_scripts": [
		{
			"matches": ["https://genius.com/*", "https://www.genius.com/*"],
			"js": ["src/content/index.js"],
			"run_at": "document_end"
		}
	],
	"permissions": [
		"storage",
		"tabs",
		"https://genius.com/*",
		"https://www.genius.com/*",
		"http://googleusercontent.com/spotify.com/*",
		"https://api.genius.com/*",
		"https://*.spotify.com/*"
	]
}
